plans/*.md

# Große Module-LLM-Pakete (~3 GB) — bei Bedarf aus dem M5Stack-APT-Repo
# nachladen, URLs in hardware_specs.md dokumentiert. Sortiert in
# pkgs/{framework,services,models}/. pkgs/audio/silent_wakeup.wav ist
# klein und bleibt getrackt im Repo.
pkgs/**/*.deb

# Sketch-Backups
src/*.bak

# Screenshot capture log (raw serial dump from `*-shots` envs).
# The decoded PNGs in screenshots/ stay tracked.
capture.log

# Local merged release binaries — produced ad-hoc when testing the
# release pipeline outside CI. CI rebuilds these in-place; the actual
# released artefacts live as GitHub release assets.
release-bins/

# uv virtualenv inside tools/. uv.lock IS tracked for reproducibility,
# the .venv directory is per-machine and must not be committed.
tools/.venv/
